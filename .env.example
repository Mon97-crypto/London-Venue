# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Must be an address on a domain you have verified in Resend (e.g. impactanalytics.co)
FROM_EMAIL="Impact Analytics Events <events@impactanalytics.co>"
# Where venue replies should go
REPLY_TO=marketing@impactanalytics.co
# Optional: BCC yourself on every RFP
BCC_EMAIL=
PORT=3000
# Set to 1 to simulate sends without calling Resend (useful for testing)
DRY_RUN=0
